.action-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 24rpx; }
.action { min-height: 148rpx; padding: 22rpx; border-radius: 24rpx; font-weight: 800; font-size: 28rpx; }
.action text { display:block; font-size:38rpx; margin-bottom:8rpx; }
.action .small { display:block; margin-top:7rpx; color:#817a6f; font-size:21rpx; font-weight:400; }
.action.mint { background:#e9f5e5; }
.action.peach { background:#fff0d6; }
.action.blue { background:#e9f1ff; grid-column:span 2; }

.badge.offline { background: #f0e0d6; color: #b8561e; }
.hero-error { color: #c0392b; font-size: 24rpx; margin-top: 8rpx; }

.status-list { margin-top: 18rpx; }
.status-row { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid rgba(0,0,0,.05); }
.status-row:last-child { border-bottom: none; }
.status-label { font-size: 26rpx; color: #777; }
.status-value { font-size: 26rpx; font-weight: 600; color: #3a3a3a; }
.status-value.good { color: #27ae60; }
.status-value.bad { color: #c0392b; }

.weather-line { display: flex; align-items: baseline; margin-top: 18rpx; }
.weather-temp { font-size: 48rpx; font-weight: 700; color: #C98B25; }
.weather-desc { font-size: 26rpx; color: #777; margin-left: 16rpx; }
.sensor-health { font-size: 22rpx; color: #27ae60; font-weight: 400; }
