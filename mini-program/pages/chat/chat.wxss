.chat-page { padding-bottom:140rpx; }.compact { min-height:190rpx; }.compact .hero-title{font-size:35rpx;margin-top:18rpx;}.compact .hero-copy{font-size:25rpx;}.compact .sun{transform:scale(.72);right:42rpx;top:38rpx;}.messages { height: calc(100vh - 700rpx); margin-top:20rpx; }.bubble { max-width:78%; margin:18rpx 0; padding:22rpx 25rpx; border-radius:24rpx; font-size:29rpx; line-height:1.6; }.bubble.bot { background:#fffefa; border-bottom-left-radius:6rpx; }.bubble.user { margin-left:auto; background:#ffe29a; border-bottom-right-radius:6rpx; }.speak { margin-top:14rpx; color:#b27b24; font-size:23rpx; }.composer { position:fixed; left:0; right:0; bottom:0; display:flex; gap:14rpx; padding:18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); background:#fffdf9; box-shadow:0 -4rpx 16rpx rgba(80,60,20,.05); }.composer input { flex:1; height:78rpx; padding:0 24rpx; border-radius:22rpx; background:#f7f1e8; font-size:27rpx; }.composer button { margin:0; border:0; border-radius:22rpx; background:#ffc64e; color:#4a301a; font-weight:800; line-height:78rpx; }.composer button::after{border:0}
