.mood-list { display:flex; flex-wrap:wrap; gap:16rpx; margin-top:24rpx; }.mood { width:calc(33.33% - 12rpx); box-sizing:border-box; padding:22rpx 0; text-align:center; border-radius:20rpx; background:#f8f3e9; font-weight:700; }.mood.selected { background:#ffe093; color:#74440e; }.reflection { margin-top:28rpx; padding:22rpx; border-radius:18rpx; background:#eaf5e6; color:#65735f; font-size:27rpx; line-height:1.6; }
